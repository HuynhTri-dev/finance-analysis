{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/.next",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/news/crawl-now",
      "schedule": "0 1 * * 1-5"
    },
    {
      "path": "/api/news/crawl-now",
      "schedule": "30 4 * * 1-5"
    },
    {
      "path": "/api/news/crawl-now",
      "schedule": "30 9 * * 1-5"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ]
}